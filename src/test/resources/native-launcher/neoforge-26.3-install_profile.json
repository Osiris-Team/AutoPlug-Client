      "classpath": [
        "net.neoforged.installertools:installertools:4.0.17:fatjar"
      ],
      "args": [
        "--task",
        "PROCESS_MINECRAFT_JAR",
        "--no-mod-manifest",
        "--input",
        "{MINECRAFT_JAR}",
        "--output",
        "{PATCHED}",
        "--extract-libraries-to",
        "{ROOT}/libraries/",
